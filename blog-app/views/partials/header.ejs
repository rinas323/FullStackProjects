<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog App</title>
  </head>
  <link rel="stylesheet" href="css/style.css" />
  <header class="bg-white shadow-sm">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="/" class="text-2xl font-bold text-indigo-600">MyBlog</a>

      <nav class="space-x-4">
        <a href="/" class="text-gray-700 hover:text-indigo-600">Home</a>
        <a href="/#search" class="text-gray-700 hover:text-indigo-600"
          >Search</a
        >

        <% if (currentUser) { %>
        <a href="/dashboard" class="text-gray-700 hover:text-indigo-600"
          >Dashboard</a
        >
        <a href="/logout" class="text-gray-700 hover:text-red-500">Logout</a>
        <% } else { %>
        <a href="/login" class="text-gray-700 hover:text-indigo-600">Login</a>
        <a
          href="/register"
          class="bg-indigo-600 text-white px-4 py-1 rounded hover:bg-indigo-700"
          >Sign Up</a
        >
        <% } %>
      </nav>
    </div>
  </header>
</html>
