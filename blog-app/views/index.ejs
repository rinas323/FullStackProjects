<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | My Blog</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen bg-gray-50 flex flex-col">

  <%- include('partials/header') %>

  <main class="grow container mx-auto p-6 text-center">
    <h2 class="text-3xl font-bold text-indigo-700 mb-4">Welcome to My Blog</h2>
    <p class="text-gray-700">A place to share your thoughts and stories.</p>

    <a href="/posts/new"
       class="inline-block mt-6 px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
       Create a Post
    </a>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
