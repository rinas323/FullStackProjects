<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MyBlog | Explore and Share Ideas</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">

  <!-- Navbar -->
  <%- include('partials/header') %>

  <!-- Hero Section -->
  <section class="bg-indigo-600 text-white py-20 text-center">
    <h1 class="text-5xl font-extrabold mb-4">Welcome to MyBlog</h1>
    <p class="text-lg opacity-90">Read. Write. Connect. Share your thoughts with the world.</p>
  </section>

  <!-- Search -->
  <section class="max-w-3xl mx-auto mt-8 px-6">
    <form action="/" method="get" class="flex">
      <input type="text" name="q" placeholder="Search blog posts..."
        class="grow border border-gray-300 rounded-l px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400" value="<%= typeof query !== 'undefined' ? query : '' %>" id="search"/>
      <button type="submit"
        class="bg-indigo-600 text-white px-6 py-2 rounded-r hover:bg-indigo-700 transition">
        Search
      </button>
    </form>
  </section>

  <!-- Posts List -->
  <main class="grow max-w-4xl mx-auto mt-10 px-6">
    <% if (posts.length === 0) { %>
      <p class="text-gray-500 text-center mt-10">No blog posts yet. Be the first to share something!</p>
    <% } else { %>
      <div class="grid md:grid-cols-2 gap-6">
        <% posts.forEach(post => { %>
          <div class="bg-white rounded-lg shadow hover:shadow-lg p-6 transition">
            <h2 class="text-2xl font-semibold text-indigo-600 mb-2">
              <a href="/posts/<%= post._id %>"><%= post.title %></a>
            </h2>
            <p class="text-gray-500 text-sm mb-3">
              Posted on <%= post.createdAt.toDateString() %>
            </p>
            <p class="text-gray-700 mb-4"><%- post.body.substring(0, 150) %>...</p>
            <a href="/posts/<%= post._id %>" class="text-indigo-500 hover:underline">Read more →</a>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

  <!-- Footer -->
  <%- include('partials/footer') %>

</body>
</html>
